{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "launchpulse",
  "main": "worker.ts",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/r/*", "/report/*", "/directories"]
  },
  "services": [
    {
      "binding": "STATEMENTFLOW_SVC",
      "service": "statementflow-ai"
    },
    {
      "binding": "HARDCALL_SVC",
      "service": "hardcall"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "launchpulse-db",
      "database_id": "b087ef3a-0f4a-463c-975d-51a7f2fb6075"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["0 13 * * *"]
  },
  "routes": [
    {
      "pattern": "pulse.statementflow.win",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "npm run build"
  }
}
